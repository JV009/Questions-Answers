- if answer.persisted?
  div.answer(id="answer-#{answer.id}")
    p.answer-body = answer.body

    - if user_signed_in? && current_user.author?(answer)
      .answer-actions
        = link_to 'Edit answer', '#',
                  class: 'edit-answer-link',
                  data: { answer_id: answer.id }

        = button_to "Delete answer", answer_path(answer),
                  method: :delete,
                  remote: true,
                  class: "delete-answer-link",
                  form: { data: { turbo: false } },
                  data: { confirm: "Are you sure?" }

      = form_with model: answer,
                 class: 'hidden edit-answer-form',
                 html: { id: "edit-answer-#{answer.id}" },
                 local: false do |f|
        .field
          = f.label :body, 'Your answer'
          = f.text_area :body,
                       id: "answer_body_#{answer.id}",
                       class: 'answer-edit-textarea'
        .actions
          = f.submit 'Save', class: 'save-answer-btn'
